# Akihlee Environment Configuration
# Copy this file to .env and update with your actual values

# Database
DATABASE_URL=jdbc:postgresql://localhost:5434/akihlee_dev
DATABASE_USERNAME=akihlee
DATABASE_PASSWORD=dev_password_change_in_production

# Redis
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=dev_redis_password

# RabbitMQ. For a managed provider like CloudAMQP, set VIRTUAL_HOST (often
# the same string as the username on their free tier) and SSL_ENABLED=true
# if connecting via the AMQPS port (usually 5671, vs. plaintext 5672).
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=akihlee
RABBITMQ_PASSWORD=dev_rabbitmq_password
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_SSL_ENABLED=false

# MinIO (S3-compatible storage)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=akihlee
S3_SECRET_KEY=dev_minio_password_min_8_chars
S3_BUCKET_DOCUMENTS=documents
S3_BUCKET_EXPORTS=exports

# Application
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Comma-separated list of origins allowed to call the API. Add the deployed
# frontend's real origin here once it exists (e.g. https://app.akihlee.com) —
# a request from an origin not in this list gets silently blocked by the
# browser's CORS check, not by any error you'll see server-side.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Security (generate new secrets for production)
JWT_SECRET=dev_jwt_secret_change_in_production_min_32_chars
ENCRYPTION_KEY=dev_encryption_key_change_in_production

# Shared secret between core-api and document-worker for the internal
# extraction callback (not a user-facing credential)
INTERNAL_API_KEY=dev_internal_worker_key_change_in_production

# Square Integration (POS/Payment data source)
# Get access token from: https://developer.squareup.com/
SQUARE_ACCESS_TOKEN=sandbox_access_token_replace_with_your_token
SQUARE_ENVIRONMENT=sandbox  # Use 'production' for live data
SQUARE_SANDBOX_APPLICATION_ID=sandbox-sq0idb-replace_with_your_app_id

# AWS Bedrock — Claude Sonnet 4.5. Powers document-worker's vision-LLM OCR
# extraction and core-api's AI CFO chat. Standard AWS SDK env var names —
# picked up automatically by boto3 (document-worker) and the AWS SDK for
# Java (core-api) via the default credential chain, no custom wiring needed.
# Leave AWS_ACCESS_KEY_ID blank to fall back to the regex OCR pipeline /
# canned AI CFO reply respectively.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Twilio WhatsApp (optional — leave blank until you have a Twilio account
# with a WhatsApp sender; the app boots fine without these, the webhook
# just can't download media or send replies until set)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Set to false only for local testing with curl, where there's no real
# X-Twilio-Signature header to validate against
TWILIO_WEBHOOK_VALIDATION_ENABLED=true

# Inbound email (optional — leave as-is until you own a domain with MX
# records pointed at an inbound-parse provider like SendGrid Inbound Parse)
EMAIL_INBOUND_DOMAIN=receipts.akihlee.com
EMAIL_WEBHOOK_SECRET=dev_email_webhook_secret_change_me
