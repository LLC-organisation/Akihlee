<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.2</version>
        <relativePath/>
    </parent>

    <groupId>com.akihlee</groupId>
    <artifactId>qbquickstart</artifactId>
    <version>0.1.0</version>
    <name>quickbooks-oauth-quickstart</name>
    <description>Standalone runnable scaffold: QuickBooks Online OAuth 2.0 authorization_code flow against the sandbox.</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <!-- Web layer (controllers) + Jackson (already transitively included,
             used to parse Intuit's token/API JSON responses). No official
             Intuit SDK is published to Maven Central (verified when this
             pattern was first used for Akihlee's own QuickBooks integration),
             so OAuth and API calls are hand-rolled with java.net.http.HttpClient
             below rather than depending on an unofficial third-party jar. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
